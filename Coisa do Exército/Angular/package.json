{
  "name": "full-stack-runner",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "scripts": {
    "start:angular": "cd Autolicitacao && ng serve",
    "start:flask": "cd flask && python main.py",
    "start:express": "cd server && node server.js",
